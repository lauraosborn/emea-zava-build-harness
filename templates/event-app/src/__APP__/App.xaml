<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="__APP__.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    RequestedTheme="Dark">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Zava / Surface AI Factory stage palette: near-black, monochrome, one accent per state -->
            <Color x:Key="CanvasColor">#07090D</Color>
            <Color x:Key="PanelColor">#10141B</Color>
            <Color x:Key="Panel2Color">#161B24</Color>
            <Color x:Key="StrokeColor">#262D3A</Color>
            <Color x:Key="InkColor">#F4F6FA</Color>
            <Color x:Key="InkSecondaryColor">#B4BDCB</Color>
            <Color x:Key="InkMutedColor">#76808F</Color>
            <Color x:Key="NpuColor">#3FD07A</Color>
            <Color x:Key="BlueColor">#5AA9FF</Color>
            <Color x:Key="AmberColor">#F2C14E</Color>
            <Color x:Key="RedColor">#FF6B6B</Color>

            <SolidColorBrush x:Key="CanvasBrush" Color="{StaticResource CanvasColor}" />
            <SolidColorBrush x:Key="PanelBrush" Color="{StaticResource PanelColor}" />
            <SolidColorBrush x:Key="Panel2Brush" Color="{StaticResource Panel2Color}" />
            <SolidColorBrush x:Key="StrokeBrush" Color="{StaticResource StrokeColor}" />
            <SolidColorBrush x:Key="InkBrush" Color="{StaticResource InkColor}" />
            <SolidColorBrush x:Key="InkSecondaryBrush" Color="{StaticResource InkSecondaryColor}" />
            <SolidColorBrush x:Key="InkMutedBrush" Color="{StaticResource InkMutedColor}" />
            <SolidColorBrush x:Key="NpuBrush" Color="{StaticResource NpuColor}" />
            <SolidColorBrush x:Key="BlueBrush" Color="{StaticResource BlueColor}" />
            <SolidColorBrush x:Key="AmberBrush" Color="{StaticResource AmberColor}" />
            <SolidColorBrush x:Key="RedBrush" Color="{StaticResource RedColor}" />

            <Style x:Key="Card" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource PanelBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource StrokeBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="Padding" Value="20" />
            </Style>

            <Style x:Key="InsetCard" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource Panel2Brush}" />
                <Setter Property="BorderBrush" Value="{StaticResource StrokeBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="12" />
            </Style>

            <Style x:Key="Chip" TargetType="Border">
                <Setter Property="Background" Value="#14FFFFFF" />
                <Setter Property="BorderBrush" Value="#30FFFFFF" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="14" />
                <Setter Property="Padding" Value="12,5" />
            </Style>

            <Style x:Key="Eyebrow" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Consolas" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="CharacterSpacing" Value="140" />
                <Setter Property="Foreground" Value="{StaticResource InkMutedBrush}" />
            </Style>

            <Style x:Key="Body" TargetType="TextBlock">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="Foreground" Value="{StaticResource InkSecondaryBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>

            <Style x:Key="Mono" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Consolas" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Foreground" Value="{StaticResource InkSecondaryBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>

            <Style x:Key="MetricValue" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Consolas" />
                <Setter Property="FontSize" Value="26" />
                <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            </Style>

            <Style x:Key="MetricLabel" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Consolas" />
                <Setter Property="FontSize" Value="11" />
                <Setter Property="CharacterSpacing" Value="100" />
                <Setter Property="Foreground" Value="{StaticResource InkMutedBrush}" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
