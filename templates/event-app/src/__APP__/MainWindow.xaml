<?xml version="1.0" encoding="utf-8"?>
<!--
    __APP_TITLE__ - generated by Zava Live Build (Surface AI Factory).
    Left: the app experience. Right: the live Local Inference panel that proves,
    in real time, which model is running and that it is running on the NPU.
    Zava branding and the "Built by Surface AI Factory" watermark are P0. Do not remove.
-->
<Window
    x:Class="__APP__.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="__APP_TITLE__">

    <Grid x:Name="RootGrid" Background="{StaticResource CanvasBrush}" RowDefinitions="Auto,*,Auto">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="F5" Invoked="RunAccelerator_Invoked" />
            <KeyboardAccelerator Key="Enter" Modifiers="Control" Invoked="RunAccelerator_Invoked" />
            <KeyboardAccelerator Key="Escape" Invoked="StopAccelerator_Invoked" />
            <KeyboardAccelerator Key="F11" Invoked="FullScreenAccelerator_Invoked" />
            <KeyboardAccelerator Key="R" Modifiers="Control" Invoked="ReplayAccelerator_Invoked" />
            <KeyboardAccelerator Key="Number1" Modifiers="Control" Invoked="SampleAccelerator_Invoked" />
            <KeyboardAccelerator Key="Number2" Modifiers="Control" Invoked="SampleAccelerator_Invoked" />
            <KeyboardAccelerator Key="Number3" Modifiers="Control" Invoked="SampleAccelerator_Invoked" />
        </Grid.KeyboardAccelerators>

        <!-- ── Header: Zava branding (Section 1.1) ─────────────────────────── -->
        <Grid Padding="28,18" ColumnDefinitions="Auto,*,Auto" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="0,0,0,1">
            <StackPanel x:Name="ZavaBrandingBar" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <Image x:Name="ZavaLogo" Source="ms-appx:///Assets/zava-logo.png" Height="32"
                       AutomationProperties.Name="Zava logo" />
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="32,0,0,0" VerticalAlignment="Center">
                <TextBlock x:Name="AppTitleText" Text="__APP_TITLE__" FontSize="26" FontWeight="Light"
                           Foreground="{StaticResource InkBrush}" />
                <TextBlock x:Name="TaglineText" Style="{StaticResource Body}" MaxLines="1" TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Border x:Name="NetworkChip" Style="{StaticResource Chip}">
                    <TextBlock x:Name="NetworkText" Text="NETWORK: CHECKING" FontFamily="Consolas" FontSize="12" />
                </Border>
                <Border x:Name="DeviceChip" Style="{StaticResource Chip}">
                    <TextBlock x:Name="DeviceChipText" Text="STARTING" FontFamily="Consolas" FontSize="12" />
                </Border>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Padding="28,22" ColumnSpacing="22" ColumnDefinitions="3*,2*">

            <!-- ── Left: the app experience ──────────────────────────────── -->
            <Grid RowDefinitions="Auto,*" RowSpacing="18">
                <Border Style="{StaticResource Card}">
                    <StackPanel Spacing="12">
                        <TextBlock Text="TRY IT LIVE" Style="{StaticResource Eyebrow}" />
                        <TextBlock x:Name="InputLabelText" FontSize="18" Foreground="{StaticResource InkBrush}" />
                        <TextBox x:Name="PromptBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="92" MaxHeight="180"
                                 FontSize="16" PlaceholderText="Type a request, or pick a sample below (Ctrl+1, 2, 3)" />
                        <StackPanel x:Name="SamplesPanel" Spacing="6" />
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Button x:Name="RunButton" Click="RunButton_Click" Style="{StaticResource AccentButtonStyle}" Padding="22,9">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE768;" FontSize="14" />
                                    <TextBlock Text="Run on the NPU   F5" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="StopButton" Content="Stop   Esc" Click="StopButton_Click" IsEnabled="False" Padding="18,9" />
                            <ToggleSwitch x:Name="ReplaySwitch" OnContent="Safety net: replay ON" OffContent="Safety net: live"
                                          Toggled="ReplaySwitch_Toggled" Margin="12,0,0,0" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Grid.Row="1" Style="{StaticResource Card}">
                    <Grid RowDefinitions="Auto,*" RowSpacing="12">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="OUTPUT" Style="{StaticResource Eyebrow}" VerticalAlignment="Center" />
                            <Border x:Name="OutputModeBadge" Grid.Column="1" Style="{StaticResource Chip}" Visibility="Collapsed">
                                <TextBlock x:Name="OutputModeText" FontFamily="Consolas" FontSize="12" />
                            </Border>
                        </Grid>
                        <ScrollViewer x:Name="OutputScroll" Grid.Row="1">
                            <StackPanel Spacing="10">
                                <TextBlock x:Name="OutputNoteText" Foreground="{StaticResource AmberBrush}" TextWrapping="Wrap" Visibility="Collapsed" />
                                <RichTextBlock x:Name="OutputText" FontSize="16" LineHeight="25" IsTextSelectionEnabled="True"
                                               Foreground="{StaticResource InkBrush}" />
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>

            <!-- ── Right: live local inference panel (Section 1.2 transparency) ── -->
            <ScrollViewer Grid.Column="1">
                <StackPanel Spacing="16">
                    <Border Style="{StaticResource Card}">
                        <StackPanel Spacing="10">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="LOCAL INFERENCE" Style="{StaticResource Eyebrow}" />
                                <Border x:Name="DeviceBadge" Grid.Column="1" CornerRadius="6" Padding="10,3" Background="#22FFFFFF">
                                    <TextBlock x:Name="DeviceBadgeText" Text="-" FontFamily="Consolas" FontWeight="Bold" FontSize="14" />
                                </Border>
                            </Grid>
                            <TextBlock x:Name="ModelNameText" Text="Model: loading" FontSize="24" Foreground="{StaticResource InkBrush}" />
                            <TextBlock x:Name="ModelIdText" Style="{StaticResource Mono}" />
                            <TextBlock x:Name="ModelMetaText" Style="{StaticResource Mono}" />
                            <TextBlock x:Name="LocalAiStatusText" Text="Local AI: starting" Style="{StaticResource Body}" />
                            <ProgressBar x:Name="LoadProgress" IsIndeterminate="True" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="12" ColumnDefinitions="*,*" ColumnSpacing="12">
                            <StackPanel Grid.ColumnSpan="2" Spacing="4">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Text="NPU UTILISATION" Style="{StaticResource MetricLabel}" />
                                    <TextBlock x:Name="NpuPeakText" Grid.Column="1" Style="{StaticResource MetricLabel}" />
                                </Grid>
                                <TextBlock x:Name="NpuStatusText" Text="NPU: 0%" Style="{StaticResource MetricValue}" Foreground="{StaticResource NpuBrush}" />
                                <Border x:Name="SparkHost" Height="70" Background="{StaticResource Panel2Brush}" CornerRadius="6">
                                    <Polyline x:Name="NpuSparkline" Stroke="{StaticResource NpuBrush}" StrokeThickness="2" />
                                </Border>
                            </StackPanel>
                            <StackPanel Grid.Row="1">
                                <TextBlock Text="TOKENS / SEC" Style="{StaticResource MetricLabel}" />
                                <TextBlock x:Name="TokenProgressText" Text="-" Style="{StaticResource MetricValue}" />
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="1">
                                <TextBlock Text="FIRST TOKEN" Style="{StaticResource MetricLabel}" />
                                <TextBlock x:Name="FirstTokenText" Text="-" Style="{StaticResource MetricValue}" />
                            </StackPanel>
                            <StackPanel Grid.Row="2">
                                <TextBlock Text="TOKENS" Style="{StaticResource MetricLabel}" />
                                <TextBlock x:Name="TokenCountText" Text="0" Style="{StaticResource MetricValue}" />
                            </StackPanel>
                            <StackPanel Grid.Row="2" Grid.Column="1">
                                <TextBlock Text="MODEL READY IN" Style="{StaticResource MetricLabel}" />
                                <TextBlock x:Name="LoadTimeText" Text="-" Style="{StaticResource MetricValue}" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel Spacing="8">
                            <TextBlock Text="THIS DEVICE" Style="{StaticResource Eyebrow}" />
                            <TextBlock x:Name="NpuNameText" Style="{StaticResource Mono}" />
                            <TextBlock x:Name="CpuNameText" Style="{StaticResource Mono}" />
                            <TextBlock Text="Inference location: this device. Cloud AI calls: none, by design." Style="{StaticResource Mono}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel Spacing="8">
                            <TextBlock Text="WHY THIS MODEL" Style="{StaticResource Eyebrow}" />
                            <StackPanel x:Name="ReasonsPanel" Spacing="4" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel Spacing="8">
                            <TextBlock Text="INFERENCE LOG" Style="{StaticResource Eyebrow}" />
                            <StackPanel x:Name="HistoryPanel" Spacing="4" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ── Footer: watermark + transparency line ───────────────────────── -->
        <Grid Grid.Row="2" Padding="28,10" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="18"
              BorderBrush="{StaticResource StrokeBrush}" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                <TextBlock Text="ZAVA" Style="{StaticResource Eyebrow}" Foreground="{StaticResource InkBrush}" />
                <TextBlock x:Name="WatermarkText" Text="Built by Surface AI Factory" Style="{StaticResource Eyebrow}" />
            </StackPanel>
            <TextBlock x:Name="TransparencyText" Grid.Column="1" Style="{StaticResource Mono}" FontSize="12"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12">
                <TextBlock Text="F5 run  ·  Esc stop  ·  Ctrl+1-3 samples  ·  Ctrl+R replay  ·  F11 full screen"
                           Style="{StaticResource MetricLabel}" VerticalAlignment="Center" />
                <HyperlinkButton Content="About" Click="AboutButton_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
