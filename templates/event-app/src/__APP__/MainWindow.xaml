<?xml version="1.0" encoding="utf-8"?>
<!--
    __APP_TITLE__ - generated by Zava Live Build (Surface AI Factory).

    App first: the page is about the job the app does for its users. Why it runs locally is
    told in plain language on the right. Model, device and speed details are secondary: they
    sit in the bottom ribbon, with a Details drawer (Ctrl+I) for presenters who want to show them.
    Zava branding and the "Built by Surface AI Factory" watermark are required. Do not remove.
-->
<Window
    x:Class="__APP__.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="__APP_TITLE__">

    <Grid x:Name="RootGrid" Background="{StaticResource CanvasBrush}" RowDefinitions="Auto,*,Auto,Auto">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="F5" Invoked="Accelerator_Invoked" />
            <KeyboardAccelerator Key="Enter" Modifiers="Control" Invoked="Accelerator_Invoked" />
            <KeyboardAccelerator Key="Escape" Invoked="Accelerator_Invoked" />
            <KeyboardAccelerator Key="F11" Invoked="Accelerator_Invoked" />
            <KeyboardAccelerator Key="R" Modifiers="Control" Invoked="Accelerator_Invoked" />
            <KeyboardAccelerator Key="I" Modifiers="Control" Invoked="Accelerator_Invoked" />
            <KeyboardAccelerator Key="L" Modifiers="Control" Invoked="Accelerator_Invoked" />
            <KeyboardAccelerator Key="Number1" Modifiers="Control" Invoked="Accelerator_Invoked" />
            <KeyboardAccelerator Key="Number2" Modifiers="Control" Invoked="Accelerator_Invoked" />
            <KeyboardAccelerator Key="Number3" Modifiers="Control" Invoked="Accelerator_Invoked" />
            <KeyboardAccelerator Key="F2" Invoked="Accelerator_Invoked" />
            <KeyboardAccelerator Key="F3" Invoked="Accelerator_Invoked" />
            <KeyboardAccelerator Key="F4" Invoked="Accelerator_Invoked" />
        </Grid.KeyboardAccelerators>

        <!-- ── Enterprise header: app identity + operational state ───────────── -->
        <Grid Padding="32,20,32,14" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="18">
            <Border Width="58" Height="58" CornerRadius="18" Background="{StaticResource AccentBrush}" VerticalAlignment="Top">
                <FontIcon x:Name="BrandMarkIcon" Glyph="&#xE946;" FontSize="28" Foreground="{StaticResource AccentInkBrush}" />
            </Border>
            <StackPanel Grid.Column="1" Spacing="3">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock x:Name="OrganisationText" Style="{StaticResource Eyebrow}" Foreground="{StaticResource AccentBrush}" />
                    <TextBlock Text="·" Style="{StaticResource Eyebrow}" />
                    <TextBlock x:Name="DomainText" Style="{StaticResource Eyebrow}" />
                </StackPanel>
                <TextBlock x:Name="AppTitleText" Text="__APP_TITLE__" FontSize="36"
                           FontFamily="{StaticResource DisplayFont}" Foreground="{StaticResource InkBrush}" />
                <TextBlock x:Name="TaglineText" Style="{StaticResource Body}" FontSize="15" MaxWidth="920"
                           HorizontalAlignment="Left" />
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Top" Margin="0,6,0,0">
                <Border x:Name="PrivacyChip" Style="{StaticResource Chip}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE72E;" FontSize="13" Foreground="{StaticResource AccentBrush}" />
                        <TextBlock Text="Runs on this device" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{StaticResource AccentBrush}" />
                    </StackPanel>
                </Border>
                <Border x:Name="NetworkChip" Style="{StaticResource Chip}" Background="{StaticResource Panel2Brush}">
                    <TextBlock x:Name="NetworkText" Text="Checking network" FontSize="13"
                               Foreground="{StaticResource InkSecondaryBrush}" />
                </Border>
            </StackPanel>
        </Grid>

        <!-- ── The app ───────────────────────────────────────────────────────── -->
        <Grid Grid.Row="1" Padding="32,4,32,20" ColumnSpacing="20" ColumnDefinitions="300,1.55*,0.9*">

            <ScrollViewer>
                <StackPanel Spacing="16">
                    <Border Style="{StaticResource HeroCard}">
                        <StackPanel Spacing="16">
                            <StackPanel Spacing="4">
                                <TextBlock x:Name="WorkflowLabelText" Text="Workflow" Foreground="{StaticResource AccentInkBrush}"
                                           FontSize="12" FontWeight="SemiBold" CharacterSpacing="50" />
                                <TextBlock x:Name="HeroTitleText" Text="Ready for operations" Foreground="{StaticResource AccentInkBrush}"
                                           FontFamily="{StaticResource DisplayFont}" FontSize="24" TextWrapping="Wrap" />
                                <TextBlock x:Name="HeroSubtitleText" Foreground="{StaticResource AccentInkBrush}" Opacity="0.82"
                                           FontSize="13" TextWrapping="Wrap" />
                            </StackPanel>
                            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                                <Border Background="#22FFFFFF" CornerRadius="10" Padding="10">
                                    <StackPanel>
                                        <TextBlock Text="Scope" Foreground="{StaticResource AccentInkBrush}" Opacity="0.72" FontSize="11" />
                                        <TextBlock x:Name="HeroMetric1Text" Foreground="{StaticResource AccentInkBrush}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="1" Background="#22FFFFFF" CornerRadius="10" Padding="10">
                                    <StackPanel>
                                        <TextBlock Text="Flow" Foreground="{StaticResource AccentInkBrush}" Opacity="0.72" FontSize="11" />
                                        <TextBlock x:Name="HeroMetric2Text" Foreground="{StaticResource AccentInkBrush}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="2" Background="#22FFFFFF" CornerRadius="10" Padding="10">
                                    <StackPanel>
                                        <TextBlock Text="Resilience" Foreground="{StaticResource AccentInkBrush}" Opacity="0.72" FontSize="11" />
                                        <TextBlock x:Name="HeroMetric3Text" Foreground="{StaticResource AccentInkBrush}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel Spacing="10">
                            <TextBlock x:Name="WorkflowHeadingText" Text="Workflows" Style="{StaticResource Heading}" FontSize="18" />
                            <StackPanel x:Name="WorkflowCardsPanel" Spacing="0" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel Spacing="8">
                            <TextBlock Text="Keyboard" Style="{StaticResource Heading}" FontSize="16" />
                            <TextBlock Style="{StaticResource Body}" Text="Run: F5 or Ctrl+Enter. Stop: Esc. Suggestions: Ctrl+1 to Ctrl+3. Details: Ctrl+I. Replay: Ctrl+R. Full screen: F11." />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer x:Name="MainScroll" Grid.Column="1" VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
            <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="16">
                <SelectorBar x:Name="ModeBar" SelectionChanged="ModeBar_SelectionChanged" />

                <Border Grid.Row="1" Style="{StaticResource Card}">
                    <StackPanel Spacing="14">
                        <TextBlock x:Name="InputLabelText" Style="{StaticResource Heading}" />

                        <!-- Private context: held in memory only, never logged, saved or sent. -->
                        <Border x:Name="ContextPanel" Style="{StaticResource InsetCard}" Visibility="Collapsed">
                            <StackPanel Spacing="10">
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <FontIcon Glyph="&#xE72E;" FontSize="12" Foreground="{StaticResource AccentBrush}" />
                                        <TextBlock x:Name="ContextTitleText" FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{StaticResource InkBrush}" />
                                        <TextBlock Text="stays on this device" FontSize="12" Foreground="{StaticResource InkMutedBrush}" />
                                    </StackPanel>
                                    <HyperlinkButton Grid.Column="1" Content="Clear" Click="ClearButton_Click" Padding="6,2" />
                                </Grid>
                                <Grid x:Name="ContextGrid" ColumnSpacing="12" />
                            </StackPanel>
                        </Border>

                        <StackPanel x:Name="LanguagePanel" Orientation="Horizontal" Spacing="10" Visibility="Collapsed">
                            <TextBlock Text="Reply in" VerticalAlignment="Center" Style="{StaticResource Body}" />
                            <ComboBox x:Name="LanguageBox" MinWidth="200" />
                        </StackPanel>

                        <Border x:Name="MediaPanel" Style="{StaticResource InsetCard}" Visibility="Collapsed">
                            <Grid ColumnDefinitions="180,*" ColumnSpacing="14">
                                <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1" CornerRadius="12" Padding="6">
                                    <Image x:Name="DemoImage" Stretch="Uniform" Height="120" />
                                </Border>
                                <StackPanel Grid.Column="1" Spacing="8">
                                    <TextBlock x:Name="DemoImageLabelText" Style="{StaticResource Heading}" FontSize="16" />
                                    <TextBlock Style="{StaticResource Body}" Text="Use the preloaded example for a guaranteed demo, or upload an image from this device. The file name is used to drive the local workflow; no image is sent to cloud AI." />
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button Content="Use demo image" Click="UseDemoImageButton_Click" Padding="12,6" />
                                        <Button Content="Upload image" Click="UploadImageButton_Click" Padding="12,6" />
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <TextBox x:Name="PromptBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="64" MaxHeight="140"
                                     FontSize="16" PlaceholderText="Type a request" />
                            <StackPanel Grid.Column="1" Spacing="8" VerticalAlignment="Top">
                                <Button x:Name="RunButton" Click="RunButton_Click" Style="{StaticResource AccentButtonStyle}"
                                        Padding="26,12" FontSize="15" HorizontalAlignment="Stretch">
                                    <TextBlock x:Name="RunButtonText" Text="Go" FontWeight="SemiBold" />
                                </Button>
                                <Button x:Name="StopButton" Content="Stop" Click="StopButton_Click" IsEnabled="False"
                                        Padding="18,6" HorizontalAlignment="Stretch" />
                            </StackPanel>
                        </Grid>
                        <TextBlock x:Name="ReadyText" Style="{StaticResource Body}" FontSize="12" />

                        <StackPanel Spacing="6">
                            <TextBlock Text="Use-case scenarios" Style="{StaticResource MetricLabel}" />
                            <StackPanel x:Name="SamplesPanel" Spacing="6" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border x:Name="OutputCard" Grid.Row="2" Style="{StaticResource Card}" MinHeight="380">
                    <Grid RowDefinitions="Auto,*" RowSpacing="12">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock x:Name="OutputTitleText" Text="Result" Style="{StaticResource Heading}" />
                            <Border x:Name="OutputModeBadge" Grid.Column="1" Style="{StaticResource Chip}" Visibility="Collapsed">
                                <TextBlock x:Name="OutputModeText" FontSize="12" FontWeight="SemiBold" />
                            </Border>
                        </Grid>
                        <ScrollViewer x:Name="OutputScroll" Grid.Row="1">
                            <StackPanel Spacing="12">
                                <TextBlock x:Name="OutputPlaceholder" Style="{StaticResource Body}"
                                           Text="Pick a suggestion above or type your own request." />
                                <TextBlock x:Name="OutputNoteText" Foreground="{StaticResource AmberBrush}" TextWrapping="Wrap" Visibility="Collapsed" />
                                <RichTextBlock x:Name="OutputText" FontSize="16" LineHeight="26" IsTextSelectionEnabled="True"
                                               Foreground="{StaticResource InkBrush}" />
                                <Border x:Name="SourcesPanel" Style="{StaticResource InsetCard}" Visibility="Collapsed">
                                    <StackPanel Spacing="6">
                                        <TextBlock x:Name="SourcesTitle" FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{StaticResource InkSecondaryBrush}" />
                                        <StackPanel x:Name="SourcesList" Spacing="3" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
            </ScrollViewer>

            <!-- ── Why local + what it knows ──────────────────────────────────── -->
            <ScrollViewer Grid.Column="2">
                <StackPanel Spacing="16">
                    <Border Style="{StaticResource Card}">
                        <StackPanel Spacing="14">
                            <TextBlock Text="Why this runs on this device" Style="{StaticResource Heading}" FontSize="18" />
                            <StackPanel x:Name="LocalDriversPanel" Spacing="14" />
                        </StackPanel>
                    </Border>

                    <Border x:Name="KnowledgeCard" Style="{StaticResource Card}" Visibility="Collapsed">
                        <StackPanel Spacing="10">
                            <TextBlock Text="What it knows" Style="{StaticResource Heading}" FontSize="18" />
                            <TextBlock x:Name="KnowledgeStatsText" Style="{StaticResource Body}" />
                            <StackPanel x:Name="KnowledgeList" Spacing="4" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel Spacing="10">
                            <TextBlock Text="This session" Style="{StaticResource Heading}" FontSize="18" />
                            <TextBlock Style="{StaticResource Body}"
                                       Text="Requests and personal details are kept in memory only. They are not logged, saved or sent anywhere." />
                            <Button Content="Clear for the next person   Ctrl+L" Click="ClearButton_Click" Padding="14,8" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ── Details drawer (Ctrl+I): model, device and live metrics for presenters ── -->
        <Border x:Name="DetailsDrawer" Grid.Row="2" Visibility="Collapsed" Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource StrokeBrush}" BorderThickness="0,1,0,0" Padding="36,16">
            <Grid ColumnDefinitions="1.2*,1.4*,1*,1.4*" ColumnSpacing="28">
                <StackPanel Spacing="4">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="LOCAL MODEL" Style="{StaticResource Eyebrow}" />
                        <Border x:Name="DeviceBadge" Grid.Column="1" CornerRadius="6" Padding="8,2" Background="{StaticResource Panel2Brush}">
                            <TextBlock x:Name="DeviceBadgeText" Text="-" FontSize="12" FontWeight="SemiBold" />
                        </Border>
                    </Grid>
                    <TextBlock x:Name="ModelNameText" Text="Model: loading" Style="{StaticResource MetricValue}" />
                    <TextBlock x:Name="ModelIdText" Style="{StaticResource Mono}" />
                    <TextBlock x:Name="ModelMetaText" Style="{StaticResource Mono}" />
                    <TextBlock x:Name="LocalAiStatusText" Text="Local AI: starting" Style="{StaticResource Body}" FontSize="12" />
                    <ToggleSwitch x:Name="ReplaySwitch" OnContent="Safety net: replay (Ctrl+R)" OffContent="Safety net: live (Ctrl+R)"
                                  Toggled="ReplaySwitch_Toggled" />
                </StackPanel>
                <Grid Grid.Column="1" RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,*" RowSpacing="8" ColumnSpacing="12">
                    <Grid Grid.ColumnSpan="2" ColumnDefinitions="*,Auto">
                        <TextBlock x:Name="NpuStatusText" Text="NPU: 0%" Style="{StaticResource MetricLabel}" />
                        <TextBlock x:Name="NpuPeakText" Grid.Column="1" Style="{StaticResource MetricLabel}" />
                    </Grid>
                    <Border x:Name="SparkHost" Grid.Row="1" Grid.ColumnSpan="2" Height="44" Background="{StaticResource Panel2Brush}" CornerRadius="6">
                        <Polyline x:Name="NpuSparkline" Stroke="{StaticResource AccentBrush}" StrokeThickness="2" />
                    </Border>
                    <StackPanel Grid.Row="2">
                        <TextBlock Text="Tokens / sec" Style="{StaticResource MetricLabel}" />
                        <TextBlock x:Name="TokenProgressText" Text="-" Style="{StaticResource MetricValue}" />
                    </StackPanel>
                    <StackPanel Grid.Row="2" Grid.Column="1">
                        <TextBlock Text="First token" Style="{StaticResource MetricLabel}" />
                        <TextBlock x:Name="FirstTokenText" Text="-" Style="{StaticResource MetricValue}" />
                    </StackPanel>
                </Grid>
                <StackPanel Grid.Column="2" Spacing="4">
                    <TextBlock Text="THIS DEVICE" Style="{StaticResource Eyebrow}" />
                    <TextBlock x:Name="NpuNameText" Style="{StaticResource Mono}" />
                    <TextBlock x:Name="CpuNameText" Style="{StaticResource Mono}" />
                    <TextBlock Style="{StaticResource Mono}" Text="Cloud AI calls: none" />
                    <TextBlock Style="{StaticResource MetricLabel}" Text="Tokens / model ready in" Margin="0,6,0,0" />
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <TextBlock x:Name="TokenCountText" Text="0" Style="{StaticResource Mono}" />
                        <TextBlock x:Name="LoadTimeText" Text="-" Style="{StaticResource Mono}" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="3" Spacing="4">
                    <TextBlock Text="WHY THIS MODEL" Style="{StaticResource Eyebrow}" />
                    <StackPanel x:Name="ReasonsPanel" Spacing="2" />
                    <TextBlock Text="RECENT RUNS" Style="{StaticResource Eyebrow}" Margin="0,8,0,0" />
                    <StackPanel x:Name="HistoryPanel" Spacing="2" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ── Ribbon: branding, watermark and the small local-AI details ─────── -->
        <Grid Grid.Row="3" Padding="36,8" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="18"
              Background="{StaticResource Panel2Brush}" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="0,1,0,0">
            <StackPanel x:Name="ZavaBrandingBar" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Image x:Name="ZavaLogo" Source="ms-appx:///Assets/zava-logo.png" Height="18" AutomationProperties.Name="Zava logo" />
                <TextBlock x:Name="WatermarkText" Text="Built by Surface AI Factory" Style="{StaticResource Ribbon}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="14" HorizontalAlignment="Center">
                <ProgressRing x:Name="LoadProgress" Width="14" Height="14" IsActive="True" />
                <TextBlock x:Name="RibbonStatusText" Style="{StaticResource Ribbon}" />
                <Border x:Name="DeviceChip" CornerRadius="4" Padding="6,1" Background="{StaticResource CanvasBrush}" VerticalAlignment="Center">
                    <TextBlock x:Name="DeviceChipText" Text="Starting" FontSize="11" FontWeight="SemiBold" />
                </Border>
                <TextBlock x:Name="TransparencyText" Style="{StaticResource Ribbon}" TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4">
                <HyperlinkButton x:Name="DetailsButton" Content="Details  Ctrl+I" Click="DetailsButton_Click" FontSize="12" />
                <HyperlinkButton Content="About" Click="AboutButton_Click" FontSize="12" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
