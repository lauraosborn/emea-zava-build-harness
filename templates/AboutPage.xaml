<?xml version="1.0" encoding="utf-8"?>
<!--
    Surface AI Factory — Section 1.1 Brand Consistency.
    This About page carries the mandatory Zava branding and the
    "Built by Surface AI Factory" watermark. Do not remove either.
-->
<Page
    x:Class="NAMESPACE.Views.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer Padding="32">
        <StackPanel Spacing="16" MaxWidth="640" HorizontalAlignment="Left">

            <!-- Zava company branding: logo + company name -->
            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <Image x:Name="ZavaLogo"
                       Source="ms-appx:///Assets/zava-logo.png"
                       Height="40"
                       AutomationProperties.Name="Zava logo" />
                <TextBlock x:Name="CompanyNameText"
                           Text="Zava"
                           FontSize="32"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center" />
            </StackPanel>

            <TextBlock x:Name="AppNameText"
                       Text="Application"
                       FontSize="20"
                       Opacity="0.8" />

            <!-- Mandatory Surface AI Factory watermark / attribution -->
            <Border Background="{ThemeResource SystemControlBackgroundListLowBrush}"
                    CornerRadius="8"
                    Padding="16">
                <StackPanel Spacing="4">
                    <TextBlock x:Name="WatermarkText"
                               Text="Built by Surface AI Factory"
                               FontWeight="SemiBold" />
                    <TextBlock Text="A Microsoft Surface engineering prototype for Zava."
                               TextWrapping="Wrap"
                               Opacity="0.8" />
                </StackPanel>
            </Border>

            <!-- AI transparency: Section 1.2 -->
            <TextBlock Text="Local AI" FontSize="18" FontWeight="SemiBold" Margin="0,8,0,0" />
            <StackPanel Spacing="4">
                <TextBlock x:Name="AboutModelNameText"   Text="Model: —" />
                <TextBlock x:Name="AboutLocalAiText"     Text="Local AI: —" />
                <TextBlock x:Name="AboutNpuStatusText"   Text="NPU: —" />
                <TextBlock x:Name="AboutTokenSpeedText"  Text="Tokens: —" />
            </StackPanel>
            <TextBlock Text="All AI inference runs locally on this device. No data leaves your device."
                       TextWrapping="Wrap"
                       Opacity="0.8" />

            <!-- Disclaimer -->
            <TextBlock Text="Disclaimer" FontSize="18" FontWeight="SemiBold" Margin="0,8,0,0" />
            <TextBlock TextWrapping="Wrap" Opacity="0.8"
                       Text="This application is a prototype created for demonstration purposes. It is not intended for production use and carries no warranty, support, or service-level commitment." />

            <TextBlock x:Name="VersionText"
                       Text="Version 1.0.0"
                       Opacity="0.6"
                       Margin="0,16,0,0" />
        </StackPanel>
    </ScrollViewer>
</Page>
